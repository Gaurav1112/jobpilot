{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "jobpilot": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "perf": "vitest run --config vitest.perf.config.ts",
    "catalogue:freehire": "tsx scripts/freehire-catalogue.ts",
    "geo:gen": "tsx scripts/gen-geo.ts",
    "contracts:export": "tsx src/bin.ts contracts export",
    "verify": "node --run typecheck && node --run test && node --run jobpilot -- contracts check && node --run jobpilot -- eval && node --run perf"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "docx": "9.9.0",
    "hono": "4.13.13",
    "htmx.org": "2.0.11",
    "pdfkit": "0.20.2",
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "volta": {
    "node": "24.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
