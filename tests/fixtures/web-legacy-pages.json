  "/freelance": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"referrer\" content=\"same-origin\">\n<meta name=\"htmx-config\" content='{\"includeIndicatorStyles\":false,\"allowEval\":false,\"allowScriptTags\":false,\"selfRequestsOnly\":true}'>\n<title>Freelance · jobpilot</title>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<header class=\"top\">\n<div class=\"top-inner\">\n<a class=\"brand\" href=\"/\">jobpilot</a>\n<nav aria-label=\"Main\"><a href=\"/\">Jobs</a><a href=\"/freelance\" aria-current=\"page\">Freelance</a><a href=\"/companies\">Companies</a><a href=\"/facts\">Your facts</a><a href=\"/runs\">Runs</a></nav>\n</div>\n</header>\n<main id=\"main\">\n<p id=\"htmx-error\" class=\"toast\" role=\"alert\" aria-live=\"assertive\" hidden></p>\n<div id=\"live\" class=\"visually-hidden\" role=\"status\" aria-live=\"polite\"></div>\n\n<div class=\"page-head\">\n<h1>Freelance</h1>\n<p class=\"lede\">Contract roles you can pitch for, best rate first, then fit. Red flags sort last. Fit floor <span class=\"num\">45</span>.</p>\n<nav class=\"tabs\" aria-label=\"Freelance\"><a href=\"/freelance?tab=contracts\" aria-current=\"page\">Contracts <span class=\"num tab-count\">0</span></a><a href=\"/freelance?tab=gigs\">Gigs <span class=\"num tab-count\">0</span></a><a href=\"/freelance?tab=review\">Review <span class=\"num tab-count\">0</span></a><a href=\"/freelance/networks\">Networks</a><a href=\"/freelance/sources\">Sources</a><a href=\"/freelance#contract-roles\">Contract roles <span class=\"num tab-count\">0</span></a></nav>\n</div>\n<section class=\"card wide roles\" id=\"contract-roles\" aria-labelledby=\"roles-h\">\n<h2 id=\"roles-h\">Contract roles matching your stack <span class=\"num tab-count\">0</span></h2>\n<p class=\"hint\">Contract roles from employer job boards (Himalayas and the daily boards) with fit <span class=\"num\">45</span> or more. Their pay or hours are not stated, so they stay in Review: ask before you apply. Best fit first, then newest.</p>\n<p class=\"empty\">No contract role from an employer job board is at or above your fit floor yet.</p>\n</section>\n\n<p class=\"empty\">No freelance run yet. The first run fills this list.</p>\n<p class=\"hint\">jobpilot never bids or applies for you: open the posting, paste the text, and mark the status here.</p>\n</main>\n</body>\n</html>\n",
  "/companies": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"referrer\" content=\"same-origin\">\n<meta name=\"htmx-config\" content='{\"includeIndicatorStyles\":false,\"allowEval\":false,\"allowScriptTags\":false,\"selfRequestsOnly\":true}'>\n<title>Companies · jobpilot</title>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<header class=\"top\">\n<div class=\"top-inner\">\n<a class=\"brand\" href=\"/\">jobpilot</a>\n<nav aria-label=\"Main\"><a href=\"/\">Jobs</a><a href=\"/freelance\">Freelance</a><a href=\"/companies\" aria-current=\"page\">Companies</a><a href=\"/facts\">Your facts</a><a href=\"/runs\">Runs</a></nav>\n</div>\n</header>\n<main id=\"main\">\n<p id=\"htmx-error\" class=\"toast\" role=\"alert\" aria-live=\"assertive\" hidden></p>\n<div id=\"live\" class=\"visually-hidden\" role=\"status\" aria-live=\"polite\"></div>\n\n<div class=\"page-head\">\n<h1>Companies</h1>\n<p class=\"lede\">The companies whose own career sites jobpilot reads. The weekly coverage run finds and checks them; the daily run reads the verified ones (and the ones you approved).</p>\n<nav class=\"tabs\" aria-label=\"Company lists\"><a href=\"#add-h\">Add a company</a><a href=\"#proposed-h\">Proposed <span class=\"num tab-count\">0</span></a><a href=\"#failing-h\">Failing <span class=\"num tab-count\">0</span></a><a href=\"#unverified-h\">Your picks not verified <span class=\"num tab-count\">0</span></a><a href=\"#verified-h\">Verified <span class=\"num tab-count\">0</span></a><a href=\"#rejected-h\">Rejected <span class=\"num tab-count\">0</span></a><a href=\"#skipped-h\">Skipped this week <span class=\"num tab-count\">0</span></a></nav>\n</div>\n\n<div class=\"stack\">\n<section class=\"card wide\" aria-labelledby=\"add-h\" id=\"add\"><h2 id=\"add-h\">Add a company</h2>\n<p class=\"note\">Give its website (https), and a name if you like. It is added to Proposed and found on the next coverage run, or now with Resolve now. Your companies.yaml is never edited.</p>\n\n<form class=\"filters co-add\" method=\"post\" action=\"/companies/add\"><input type=\"hidden\" name=\"_csrf\" value=\"83bfff8c1933bd86bfb7c06cf17ba1eabb16fd15ff62095a33912822d74a6ffd\">\n<div class=\"filter-row\">\n<label class=\"field grow\"><span>Website</span><input type=\"url\" name=\"website\" value=\"\" placeholder=\"https://example.com\" maxlength=\"300\" inputmode=\"url\"></label>\n<label class=\"field grow\"><span>Name (optional)</span><input type=\"text\" name=\"name\" value=\"\" placeholder=\"Example Co\" maxlength=\"100\"></label>\n<div class=\"filter-actions\"><button class=\"btn btn-primary\">Add</button></div>\n</div>\n</form>\n</section><section class=\"card wide\" aria-labelledby=\"proposed-h\"><h2 id=\"proposed-h\">Proposed <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">Found, but a check did not pass, so nothing is read until you approve. The reasons say what did not match.</p>\n<p class=\"muted\">Nothing waiting for you.</p>\n</section><section class=\"card wide\" aria-labelledby=\"failing-h\"><h2 id=\"failing-h\">Failing <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">Verified companies whose board stopped answering 3 weeks running. Still tried daily so they can recover; never removed without you.</p>\n<p class=\"muted\">No board is failing.</p>\n</section><section class=\"card wide\" aria-labelledby=\"unverified-h\"><h2 id=\"unverified-h\">Your picks not verified <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">Companies you picked whose board did not pass the check; the weekly run tries again.</p>\n<p class=\"muted\">None.</p>\n</section><section class=\"card wide\" aria-labelledby=\"verified-h\"><h2 id=\"verified-h\">Verified <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">Read by the daily run. Reject one to stop reading it from the next run.</p>\n<p class=\"muted\">No verified company yet.</p>\n</section><section class=\"card wide\" aria-labelledby=\"rejected-h\"><h2 id=\"rejected-h\">Rejected <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">Never read and never verified again. Undo reject puts one back in Proposed; Approve makes it read daily.</p>\n<p class=\"muted\">You have rejected none.</p>\n</section><section class=\"card wide\" aria-labelledby=\"skipped-h\"><h2 id=\"skipped-h\">Skipped this week <span class=\"num tab-count\">0</span></h2>\n<p class=\"note\">These sites refused or blocked jobpilot this week, so it left them alone. They're tried again next week.</p>\n<p class=\"muted\">No coverage run this week yet.</p>\n</section>\n</div>\n</main>\n</body>\n</html>\n",
